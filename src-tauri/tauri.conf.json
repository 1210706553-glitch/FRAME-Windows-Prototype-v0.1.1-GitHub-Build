{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "张诗语の米奇妙妙工具",
  "version": "0.6.0",
  "identifier": "com.sunday.frame",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0 --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "张诗语の米奇妙妙工具",
        "width": 1480,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "dataDirectory": "mickey-toolkit"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4Nzk0MkU4MDJDNDY2NDUKUldSRlpzUUM2RUo1V0VzMVNXMVNReExPcWRkazhSUmladDNUc2kyUGJQSTBvbGdDZDhhYmtXNEQK",
      "endpoints": [
        "https://github.com/1210706553-glitch/FRAME-Windows-Prototype-v0.1.1-GitHub-Build/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
